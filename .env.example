# FastAPI reads this file as .env. Keep inference on loopback by default.
GEMMA_BASE_URL=http://127.0.0.1:8080/v1
GEMMA_MODEL=gemma4
GEMMA_BACKEND=llama.cpp
GEMMA_API_KEY=
GEMMA_TIMEOUT_SECONDS=180

# Shell launcher settings are environment variables, not read from .env.
# See docs/setup-mac.md and docs/setup-linux-gpu.md.
